# ==============================================================================
# Modal SDXL Generator Configuration
# ==============================================================================

# Remote Modal generation endpoint URL (obtained after running `modal deploy text2image.py`)
MODAL_ENDPOINT=https://yourusername--text2image-inference-generate.modal.run

# GPU type to request on Modal (e.g., L4, A10G, A100, H100)
GPU_TYPE=L4

# Local server network binding
HOST=0.0.0.0
PORT=5000

# NOTE: For CivitAI models and LoRAs, create a Modal secret named "civitai-token":
# modal secret create civitai-token --value "YOUR_CIVITAI_API_TOKEN"
# Obtain your token at: https://civitai.com/user/account